<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AbpToVolo.Desktop</RootNamespace>
    <AssemblyName>AbpToVolo.Desktop</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>2.0.0</Version>
    <Description>Windows app of the ASP.NET Boilerplate → ABP.io converter.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AbpToVolo.Engine\AbpToVolo.Engine.csproj" />
  </ItemGroup>

</Project>
